{
  "name": "weblog",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "dev": "ng serve",
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "start": "node dist/weblog/server/server.mjs",
    "seed": "tsx scripts/seed.ts",
    "test:api": "node --import tsx --test \"api/**/*.test.ts\"",
    "test:web": "ng test --watch=false --browsers=ChromeHeadless",
    "test": "npm run test:api && npm run test:web"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.1.0",
    "@angular/common": "^18.1.0",
    "@angular/compiler": "^18.1.0",
    "@angular/core": "^18.1.0",
    "@angular/forms": "^18.1.0",
    "@angular/platform-browser": "^18.1.0",
    "@angular/platform-browser-dynamic": "^18.1.0",
    "@angular/platform-server": "^18.1.0",
    "@angular/router": "^18.1.0",
    "@angular/ssr": "^18.1.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.1.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.18.2",
    "marked": "^18.2.0",
    "rxjs": "~7.8.0",
    "sanitize-html": "^2.18.2",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.1.0",
    "@angular/cli": "^18.1.0",
    "@angular/compiler-cli": "^18.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~5.5.2"
  },
  "allowScripts": {
    "better-sqlite3@13.1.1": true,
    "esbuild@0.23.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}

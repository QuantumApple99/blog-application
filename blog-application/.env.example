# HTTP port the server listens on
PORT=4000
# SQLite database file path (relative paths resolve from the project root)
DATABASE_PATH=./data/weblog.db
# development is only a local convention; use production in Docker/deploy
# NODE_ENV=development
# Set true when served over HTTPS; Secure is only applied when NODE_ENV=production and this is not false
COOKIE_SECURE=false
# bcrypt cost factor for password hashing
BCRYPT_ROUNDS=12
